<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol>100</defaultcontrol>
	<backgroundcolor>background</backgroundcolor>
	<controls>
		<control type="button" id="100">
			<left>100</left>
			<top>100</top>
			<width>300</width>
			<height>100</height>
			<text>Button with Shader</text>
			<texturefocus>button-focus.png</texturefocus>
			<texturenofocus>button-nofocus.png</texturenofocus>
			<onclick>noop</onclick>
			<controls>
				<control type="shader" id="101">
					<left>0</left>
					<top>0</top>
					<width>300</width>
					<height>100</height>
					<shaderfile>basic.frag</shaderfile>
					<action>onfocus</action>
				</control>
			</controls>
		</control>
		<control type="button" id="200">
			<left>100</left>
			<top>250</top>
			<width>300</width>
			<height>100</height>
			<text>Button without Shader</text>
			<texturefocus>button-focus.png</texturefocus>
			<texturenofocus>button-nofocus.png</texturenofocus>
			<onclick>noop</onclick>
		</control>
	</controls>
</window>
